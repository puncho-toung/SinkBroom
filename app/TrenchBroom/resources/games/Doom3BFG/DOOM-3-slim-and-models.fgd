	decel_time(string) : "time in seconds to decelerate"
	innerdoor(string) : "door name for interior doors, these will move automatically with the elevator."
	floorPos_1(string) : "origin of first floor"
	floorDoor_1(string) : "door name for floor 1 exterior door"
	floor(string) : "floor number to start on 1 through.. number of floors"
	pauseOnFloor(string) : "floor to pause on before opening doors"
	pauseTime(string) : "time to pause if pauseOnFloor is defined"
	statusgui(string) : "entity name to update floor info, can use statusgui2..3..4..etc. for multiple updates.  if appended with _num it will target an optional specific gui number on the entity this is handy for models with multiple guis."
