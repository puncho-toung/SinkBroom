@PointClass color(0 127 204) = moveable_base : "Moveable object. Will drop to the floor and rest untill activated.
The visual model set with the 'model' key can also be used for
collision detection. However the model may not be too complex.
max vertices = 32
max edges = 32
max polygons = 16
max edges per polygon = 16
The collision model must be an enclosed hull. Dangling polygons or
edges are not allowed. If the visual model is too complex or does
not meet these requirements it can be contained in a less complex
model for collision detection. Such a collision model is specified with the
'clipmodel' key."
[
	spawnclass(string) readonly : "" : "idMoveable"
	density(string) : "Volume of the object times the density is the mass." : "0.5"
	friction(string) : "Friction with contacting surfaces in the range [0-1] where 0 is no friction." : "0.05"
	bouncyness(string) : "How much the object bounces in the range [0-1] where 0 is no bounce." : "0.6"
	explode(choices) : "If set to 1 the moveable explodes and is removed when the health drops down to or below zero." : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	unbindondeath(choices) : "Unbind entity when health drops down to or below zero." : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	health(string) : "If set the visual model changes to 'broken' when the health drops down to or below zero." : "0"
	nodrop(choices) : "Do not drop to the floor." : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	noimpact(choices) : "Do not activate by the impact of other objects." : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	notpushable(choices) : "Do not allow to be pushed." : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	clipshrink(string) : "Shrink the visual model with an epsilon and use it as a clip model." : "0"
	allowStep(string) : "Set to 0 to prevent monsters from ever walking over this object." : "1"
	snd_bounce(string) : "" : "smallpanel_impact"
	mass(string) : "Mass of the object (overrides density)."
	clipmodel(string) : "Model to be used for collision detection."
	nonsolid(string) : "Make the object non-solid."
	broken(string) : "Visual model to be used when the health drops down to or below zero."
	init_velocity(string) : "Initial linear velocity set when activated."
	init_avelocity(string) : "Initial angular velocity set when activated."
	init_velocityDelay(string) : "Delay in seconds before the initial linear velocity is set after being activated."
	init_avelocityDelay(string) : "Delay in seconds before the initial angular velocity is set after being activated."
	initialSplineTime(string) : "Number of milliseconds the moveable should follow the initial spline path."
	damage(string) : "Damage definition if it damages things it collides with"
	damageWhenActive(string) : "Only damage when active ( currently for the vagary and influence stuff )"
	fx_collide(string) : "FX system to start at impact position when object collides."
	name(target_source) : "Entity name; other entities target this"
	target(target_destination) : "Entity to trigger; target1..targetN also link"
]

