	talk1_blendout(string) : "# frames to blend out of primary talk anim." : "8"
	talk2_blendin(string) : "# frames to blend into secondary talk anim." : "8"
	talk2_blendout(string) : "# frames to blend out of secondary talk anim." : "8"
