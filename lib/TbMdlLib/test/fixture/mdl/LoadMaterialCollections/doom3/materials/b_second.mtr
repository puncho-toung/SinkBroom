// Doom 3 materials for the material pipeline tests. Written by hand.

table fixturetable { { 0, 1 } }

// already defined in a_first.mtr
textures/test/duplicate
{
	diffusemap	textures/test/diffuse_d.tga
}

// outside of the material root: not in the browser, but available to entity models
models/test/crate
{
	diffusemap	models/test/crate_d.tga
}

// uses textures/test/tb_editor_shared's editor image in a diffuse stage
models/test/uses_tbshared
{
	diffusemap	textures/test/tbshared_ed.tga
}
