// DOOM 3 BFG game definition file (.fgd) generated by RBDOOM 3 BFG 1.6.0
// TrenchBroom test fixture. The classes worldspawn to misc_model are cut unchanged from
// base/_tb/fgd/DOOM-3-slim.fgd and auto_generated_model from base/_tb/fgd/DOOM-3-models.fgd,
// both exported by the engine in the GPL-3.0 RBDOOM-3-BFG repository. genmodel_tb_test_arrow is
// written by hand in the exporter's format for the fixture model _tb/models/tb_test/arrow.obj.

@SolidClass color(0 0 0) = worldspawn : "Every map should have exactly one worldspawn."
[
	spawnclass(string) readonly : "" : "idWorldspawn"
	gravity(string) : "gravity value for the level." : "1066"
	name(string) : "" : "world"
	music(string) : "music wav file."
	no_stamina(string) : "disables stamina so the player can always run"
	no_Weapons(string) : "only fists and no melee attacks"
	def_player(string) : "player def to use when spawning this world"
]

@SolidClass color(0 127 204) = func_static : "A brush model that just sits there, doing nothing.  Can be used for conditional walls and models.
When triggered, toggles between visible and hidden (see hide).  Entity is non-solid when hidden."
[
	spawnclass(string) readonly : "" : "idStaticEntity"
	solid(choices) : "whether the object should be solid or not." : 1 =
	[
		0 : "No"
		1 : "Yes"
	]
	noclipmodel(choices) : "0 by default. Sets whether or not to generate a collision model for an ASE/LWO func_static at level load. (Set to 1 for stuff the player can't interact with. This will save memory.)" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	hide(choices) : "whether the object should be visible when spawned. you need to set a value for triggering on/off to work" =
	[
		0 : "No"
		1 : "Yes"
	]
	gui(string) : "gui attached to this static, gui2 and gui3 also work"
	gui_demonic(string) : "demonic gui attached to this statit, gui_demonic2 and gui_demonic3 also work"
	gui_noninteractive(choices) : "any gui attached will not be interactive" =
	[
		0 : "No"
		1 : "Yes"
	]
	inline(choices) : "If true, turn the model into map geometry at dmap time" =
	[
		0 : "No"
		1 : "Yes"
	]
	name(target_source) : "Entity name; other entities target this"
	target(target_destination) : "Entity to trigger; target1..targetN also link"
]

@PointClass color(0 255 0) size(-8 -8 -8, 8 8 8) model({{
	proxymodel -> { "path": proxymodel },
	{ "path": "sprites/light-bulb.png", "scale": 0.03125 }
}})= light : "Light source.  If health is set, light becomes breakable and turns off when shot."
[
	style(Choices) : "Appearance" : -1 =
	[
		-1 : "None (engine default)"
		0 : "Normal"
		10: "Fluorescent flicker"
		2 : "Slow, strong pulse"
		11: "Slow pulse, noblack"
		5 : "Gentle pulse"
		1 : "Flicker A"
		6 : "Flicker B"
		3 : "Candle A"
		7 : "Candle B"
		8 : "Candle C"
		4 : "Fast strobe"
		9 : "Slow strobe"
	]
	light(integer) : "light radius" : 300
	spawnclass(string) readonly : "" : "idLight"
	health(string) : "amount of damage to recieve before becoming broken.  0 is nonbreakable." : "0"
	levels(string) : "the number of times a light must be triggered until it turns off.  Each time it's triggered, it's dimmed to a lower level." : "1"
	start_off(string) : "causes the light to be off when the level starts." : "0"
	count(string) : "how many times light must be triggered to toggle." : "1"
	break(string) : "break when triggered." : "0"
	texture(string) : "light shader to use."
	_color(color1) : "light color"
	shaderParm3(string) : "shaderParm 3"
	shaderParm4(string) : "shaderParm 4"
	shaderParm5(string) : "shaderParm 5"
	shaderParm6(string) : "shaderParm 6"
	shaderParm7(string) : "shaderParm 7"
	modelTarget(target_destination) : "name of func_static entity as a replacement for model on this entity"
	model(string) : "model to use."
	broken(string) : "model to use when the light is broken (defaults to model name with '_broken' appended to name)"
	hideModelOnBreak(string) : "hides the model when broken"
	target(target_destination) : "entities to trigger if shot."
	snd_broken(string) : "sound shader to use when broken"
	mtr_broken(string) : "material to use when broken"
	color_demonic(color1) : "demonic color to use if in demonic mode."
	mat_demonic(string) : "demonic shader to use if in demonic mode."
	leave_demonic_mat(string) : "leaves the demonic shader when the effect expires.. color is still reverted back."
	proxymodel(string) : "A proxy model in OBJ file format automatically set by RBDoom so it can be displayed in TrenchBroom"
	name(target_source) : "Entity name; other entities target this"
]

@PointClass color(255 0 0) size(-16 -16 0, 16 16 64) = info_player_start : "Potential spawning position for single player games."
[
	spawnclass(string) readonly : "" : "idPlayerStart"
	useEffect(string) : "show teleportation effect for useEffect seconds.. 0 is instant"
	skin(string) : "skin to use for player model"
	name(target_source) : "Entity name; other entities target this"
	target(target_destination) : "Entity to trigger; target1..targetN also link"
]

@SolidClass color(0 127 204) = func_door : "Door."
[
	spawnclass(string) readonly : "" : "idDoor"
	start_open(choices) : "the door moves to its destination when spawned, and operate in reverse.  It is used to temporarily or permanently close off an area when triggered (not useful for touch or takedamage doors)." : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	no_touch(choices) : "the door should not be triggered by the player touching it, only by another trigger. in multiplayer, this door can't be shot to open." : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	crusher(choices) : "the door does not reverse when blocked." : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	angle(string) : "determines the opening direction." : "0"
	speed(string) : "movement speed." : "100"
	wait(choices) : "wait before returning (-1 = never return)." : 3 =
	[
		0 : "No"
		1 : "Yes"
	]
	lip(string) : "lip remaining at end of move." : "8"
	dmg(string) : "damage to inflict when blocked." : "2"
	health(string) : "if set, the door must be shot open." : "0"
	triggersize(string) : "sets the amount the trigger extends from the door." : "60"
	snd_close(string) : "sound to play when closing." : "default_door_close"
	snd_open(string) : "sound to play when opening." : "default_door_open"
	snd_opened(string) : "looping sound for it's opened state."
	snd_locked(string) : "sound to play if door is locked and player approaches." : "default_door_locked"
	snd_unlocked(string) : "" : "default_door_unlocked"
	locked(choices) : "used in conjunction with no_touch,the door must be triggered by a trigger, after which it works normally.  if locked = 1 then the door opens when unlocked, if locked = 2 then the door just becomes unlocked." =
	[
		0 : "No"
		1 : "Yes"
	]
	buddy(target_destination) : "will toggle shaderparm 7 of the entity given as a buddy, this allows shaders to be remapped for lock status etc."
	movedir(string) : "determines the opening direction.  if set, 'angle' determines orientation."
	time(string) : "movement time in seconds.  overrides speed.  used for doors that move different distances, but still need to be synced."
	toggle(choices) : "wait at each position until triggered again." =
	[
		0 : "No"
		1 : "Yes"
	]
	gui_noninteractive(choices) : "any gui attached will not be interactive" =
	[
		0 : "No"
		1 : "Yes"
	]
	triggerClosed(target_destination) : "name of entity to trigger when door closes, can be iterated with triggerClosed2, 3 etc."
	triggerOpened(target_destination) : "name of entity to trigger when door opens, can be iterated with triggerOpened2, 3 etc."
	triggerBlocked(target_destination) : "name of entity to trigger when door is blocked, can be iterated with triggerBlocked2, 3 etc."
	name(target_source) : "Entity name; other entities target this"
	target(target_destination) : "Entity to trigger; target1..targetN also link"
]

@PointClass color(255 255 0) size(-6 -6 -6, 6 6 6) model({ "path": "sprites/info_notnull.png", "scale": 0.25 }) = target_null : "Generic target to point camera views at"
[
	spawnclass(string) readonly : "" : "idTarget"
	name(target_source) : "Entity name; other entities target this"
	target(target_destination) : "Entity to trigger; target1..targetN also link"
]

@SolidClass color(127 127 127) = trigger_once : "Variable sized single-use trigger.  Must be targeted at one or more entities."
[
	spawnclass(string) readonly : "" : "idTrigger_Multi"
	wait(string) : "" : "-1"
	random(string) : "" : "0"
	delay(string) : "seconds to wait before firing after triggered." : "0"
	anyTouch(string) : "anything can touch it, players, mobs." : "0"
	noTouch(string) : "cannot be touched, must be triggered." : "0"
	noClient(string) : "can't be touched by players, but can be touched by other entities (func_activators, for instance)." : "0"
	call(string) : "script function to call when triggered."
	requires(string) : "item required in players inventory to fire."
	removeItem(string) : "if above item is removed from inventory when used."
	triggerFirst(string) : "don't activate until triggered."
	name(target_source) : "Entity name; other entities target this"
	target(target_destination) : "Entity to trigger; target1..targetN also link"
]

@PointClass base(func_static) color(0 127 204) size(-8 -8 0, 8 8 16) model({{
	proxymodel -> { "path": proxymodel },
	{ "path": model }
}})= misc_model : "Inherits from a func_static but uses a model and is a FGD PointClass so it displays correctly in TrenchBroom.
Use it to place all kinds of models"
[
	model(string) : "Model Selection (ex mapobjects/model.obj)"
	proxymodel(string) : "A proxy model in OBJ file format automatically set by RBDoom so it can be displayed in TrenchBroom"
	name(target_source) : "Entity name; other entities target this"
	target(target_destination) : "Entity to trigger; target1..targetN also link"
]

@PointClass base(misc_model) = auto_generated_model : "Entity definition for a specific model" []

@PointClass base(auto_generated_model) model({ "path": "_tb/models/tb_test/arrow.obj" }) = genmodel_tb_test_arrow : "Display entity"
[
	proxymodel(string) : "" : "_tb/models/tb_test/arrow.obj"
	model(string) : "" : "models/tb_test/arrow.lwo"
]
