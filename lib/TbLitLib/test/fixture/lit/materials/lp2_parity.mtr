// LP2.3 parity fixtures (plans/lit-preview/27-LP2-PACKAGES.md section 4, C29); written by
// TOOLS/lit-preview/parity.py fixtures. Names under textures/lp2/ and lights/lp2/ are
// reserved for fixtures (K20). Every lit material is IBL-neutral (P2.2): legacy without a
// specular stage, or a specular _s whose _rmao.png has metal 0. No stage names _white or
// _black (the engine turns them into game files, Image_program.cpp:483-494).

// R01, R02, R03, R04, R07, R08, R09, R10, R12: legacy, diffuse and bump only
textures/lp2/floor
{
	qer_editorimage	textures/lp2/floor.tga
	diffusemap	textures/lp2/floor.tga
	bumpmap	textures/lp2/floor_local.tga
}

textures/lp2/wall
{
	qer_editorimage	textures/lp2/wall.tga
	diffusemap	textures/lp2/wall.tga
	bumpmap	textures/lp2/wall_local.tga
}

// R05: PBR, base colour, bump and an _s that resolves to its _rmao.png (metal 0)
textures/lp2/pbr
{
	qer_editorimage	textures/lp2/pbr.tga
	basecolormap	textures/lp2/pbr.tga
	bumpmap	textures/lp2/pbr_local.tga
	specularmap	textures/lp2/pbr_s.tga
}

// R06: legacy with the _s + _rmao.png pair (TD_SPECULAR_PBR_RMAO, R5.5), metal 0, the
// implicit _flat bump
textures/lp2/legacy
{
	qer_editorimage	textures/lp2/legacy.tga
	diffusemap	textures/lp2/legacy.tga
	specularmap	textures/lp2/legacy_s.tga
}

// R07: alpha tested (MC_PERFORATED), not translucent
textures/lp2/grate
{
	qer_editorimage	textures/lp2/grate.tga
	bumpmap	textures/lp2/floor_local.tga
	{
		blend	diffusemap
		map	textures/lp2/grate.tga
		alphaTest	0.5
	}
}

// R07: the same with polygonOffset: the engine leaves MF_POLYGONOFFSET perforated
// surfaces unlit in the interaction pass (P2.21, D75)
textures/lp2/grate_offset
{
	qer_editorimage	textures/lp2/grate.tga
	polygonOffset	1
	bumpmap	textures/lp2/floor_local.tga
	{
		blend	diffusemap
		map	textures/lp2/grate.tga
		alphaTest	0.5
	}
}

// R08, R09: the diffuse stage takes the entity's colour (colored: parm0-parm3)
textures/lp2/tinted
{
	qer_editorimage	textures/lp2/crate.tga
	bumpmap	textures/lp2/crate_local.tga
	{
		blend	diffusemap
		map	textures/lp2/crate.tga
		colored
	}
}

// R12
textures/lp2/crate
{
	qer_editorimage	textures/lp2/crate.tga
	diffusemap	textures/lp2/crate.tga
	bumpmap	textures/lp2/crate_local.tga
}

// R10
textures/lp2/patch
{
	qer_editorimage	textures/lp2/patch.tga
	diffusemap	textures/lp2/patch.tga
	bumpmap	textures/lp2/patch_local.tga
}

// R11: a face with rotated and scaled texture axes
textures/lp2/checker
{
	qer_editorimage	textures/lp2/checker.tga
	diffusemap	textures/lp2/checker.tga
	bumpmap	textures/lp2/floor_local.tga
}

// K28 (31-LP2-FIXES.md): the near pieces of a room's floor, ceiling and side walls, cut 100
// units ahead of the row's camera so that no triangle the camera sees crosses its near
// plane; a material of their own, so that dmap's optimizer keeps them apart from the far
// pieces; never in view
textures/lp2/near
{
	qer_editorimage	textures/lp2/wall.tga
	diffusemap	textures/lp2/wall.tga
	bumpmap	textures/lp2/wall_local.tga
}

// R19, R20, R21 (V2.1): legacy diffuse on an explicit flat normal and no specular stage,
// so the shading reads no view vector and the triangulation cannot change a pixel (K28)
textures/lp2/flatwall
{
	qer_editorimage	textures/lp2/wall.tga
	diffusemap	textures/lp2/wall.tga
	bumpmap	_flat
}

// R13, R14: a white surface without a bump map (the implicit _flat)
textures/lp2/white
{
	qer_editorimage	textures/lp2/white.tga
	diffusemap	textures/lp2/white.tga
}

// R18: a translucent lit surface (interactions with DEPTHFUNC_LESS, no prepass)
textures/lp2/glass_lit
{
	qer_editorimage	textures/lp2/checker.tga
	translucent
	diffusemap	textures/lp2/checker.tga
}

// R18: a surface stage's texture matrix past RB_GetShaderTextureMatrix's +-40 wrap
textures/lp2/wrap
{
	qer_editorimage	textures/lp2/checker.tga
	bumpmap	textures/lp2/floor_local.tga
	{
		blend	diffusemap
		map	textures/lp2/checker.tga
		translate	45.5, -41.25
	}
}

// R18: a vertex-colour diffuse stage
textures/lp2/vcolor
{
	qer_editorimage	textures/lp2/crate.tga
	bumpmap	textures/lp2/crate_local.tga
	{
		blend	diffusemap
		map	textures/lp2/crate.tga
		vertexColor
	}
}

// R18: stages on condition registers (the entity's shaderParm5 1 turns the first on, its
// shaderParm6 0 leaves the second off)
textures/lp2/cond
{
	qer_editorimage	textures/lp2/crate.tga
	bumpmap	textures/lp2/crate_local.tga
	{
		if ( parm5 > 0.5 )
		blend	diffusemap
		map	textures/lp2/crate.tga
	}
	{
		if ( parm6 > 0.5 )
		blend	diffusemap
		map	textures/lp2/checker.tga
	}
}

// R18: polygon offset on an opaque surface
textures/lp2/offset
{
	qer_editorimage	textures/lp2/legacy.tga
	polygonOffset	1
	diffusemap	textures/lp2/legacy.tga
	bumpmap	textures/lp2/floor_local.tga
}

// the lights: their images are files under lights/lp2/ (no _white, no default light shader)
lights/lp2/round
{
	lightFalloffImage	lights/lp2/falloff.tga
	{
		map	lights/lp2/round.tga
		colored
		zeroClamp
	}
}

lights/lp2/spot
{
	lightFalloffImage	lights/lp2/falloff_linear.tga
	{
		map	lights/lp2/spot.tga
		colored
		zeroClamp
	}
}

lights/lp2/square
{
	lightFalloffImage	lights/lp2/falloff.tga
	{
		map	lights/lp2/square.tga
		colored
		zeroClamp
	}
}

// R13, R14: white to the volume's planes and past them (clamp), the falloff white too
lights/lp2/flat
{
	lightFalloffImage	lights/lp2/white_falloff.tga
	{
		map	lights/lp2/white.tga
		colored
		clamp
	}
}

// R13: a projected light whose falloff is white at its near and far planes
lights/lp2/spotflat
{
	lightFalloffImage	lights/lp2/white_falloff.tga
	{
		map	lights/lp2/spot.tga
		colored
		zeroClamp
	}
}

// R17: a light material of two stages
lights/lp2/twostage
{
	lightFalloffImage	lights/lp2/falloff.tga
	{
		map	lights/lp2/round.tga
		colored
		zeroClamp
	}
	{
		map	lights/lp2/square.tga
		red	0.25
		green	0.5
		blue	0.75
		zeroClamp
	}
}

// C17 (V2.8): the lights-off map's copy of lights/lp2/twostage: its constant stage at zero,
// the colored stage dark through _color 0 0 0
lights/lp2/twostage_dark
{
	lightFalloffImage	lights/lp2/falloff.tga
	{
		map	lights/lp2/round.tga
		colored
		zeroClamp
	}
	{
		map	lights/lp2/square.tga
		red	0
		green	0
		blue	0
		zeroClamp
	}
}

// R18: a light stage with a texture matrix (RB_BakeTextureMatrixIntoTexgen)
lights/lp2/matrix
{
	lightFalloffImage	lights/lp2/falloff.tga
	{
		map	lights/lp2/round.tga
		colored
		zeroClamp
		scale	0.8, 0.8
		translate	0.1, 0.1
	}
}
