// LP5.1 stages parity fixture (plans/lit-preview/41-LP5-PACKAGES.md C50, section 4
// "LP5.1"); written by TOOLS/lit-preview/parity.py fixtures. The lights' images are
// lp2_parity.mtr's (staged with it). Names under textures/lp5/ and lights/lp5/ are
// reserved for fixtures (K20). No stage names _white or _black; no time or sound register
// (D119). The M and B rooms' materials have no SL_AMBIENT stage; LP5.2a's S rooms' do.

// M01-M05, B01's floor: legacy diffuse and bump, no specular stage
textures/lp5/bump
{
	qer_editorimage	textures/lp5/bump.tga
	diffusemap	textures/lp5/bump.tga
	bumpmap	textures/lp5/bump_local.tga
}

// K28: the near pieces of a room's floor, ceiling and side walls, cut 100 units ahead of
// its camera; a material of their own, so that dmap keeps them apart
textures/lp5/near
{
	qer_editorimage	textures/lp5/bump.tga
	diffusemap	textures/lp5/bump.tga
	bumpmap	textures/lp5/bump_local.tga
}

// the same for the flat rooms (M06, M07)
textures/lp5/near_flat
{
	qer_editorimage	textures/lp5/flat.tga
	diffusemap	textures/lp5/flat.tga
	bumpmap	_flat
}

// M06, M07: legacy diffuse on an explicit flat normal, no specular stage
textures/lp5/flat
{
	qer_editorimage	textures/lp5/flat.tga
	diffusemap	textures/lp5/flat.tga
	bumpmap	_flat
}

// B01's walls: PBR, base colour, bump and an _s whose _rmao.png sibling the engine prefers
// (metal 0); under an ambientLight light its specular is _black, so it draws through
// interactionAmbient's legacy row 21 as the floor does
textures/lp5/pbr
{
	qer_editorimage	textures/lp5/pbr.tga
	basecolormap	textures/lp5/pbr.tga
	bumpmap	textures/lp5/pbr_local.tga
	specularmap	textures/lp5/pbr_s.tga
}

// B01: an ambientLight light (Material.cpp:2758-2760): no shadows, its specular _black,
// interactionAmbient's fixed tangent-space light vector
lights/lp5/ambient
{
	ambientLight
	lightFalloffImage	lights/lp2/falloff.tga
	{
		map	lights/lp2/round.tga
		colored
		zeroClamp
	}
}

// ----- LP5.2a: the S rooms (pass 8). Their wall: white, no bump (the implicit _flat), lit
// head-on by R14's parallel light; every stage below is SL_AMBIENT, unlit

textures/lp5/white_wall
{
	qer_editorimage	textures/lp5/white.tga
	diffusemap	textures/lp5/white.tga
}

// S01: blend add (its second stage gl_zero, gl_one: skipped by pass 8, RenderBackend.cpp
// :4457), blend blend, blend filter
textures/lp5/s01_add
{
	qer_editorimage	textures/lp5/s_red.tga
	{
		blend	add
		map	textures/lp5/s_red.tga
	}
	{
		blend	gl_zero, gl_one
		map	textures/lp5/s_red.tga
	}
}

textures/lp5/s01_blend
{
	qer_editorimage	textures/lp5/s_green_a.tga
	{
		blend	blend
		map	textures/lp5/s_green_a.tga
	}
}

textures/lp5/s01_filter
{
	qer_editorimage	textures/lp5/s_blue.tga
	{
		blend	filter
		map	textures/lp5/s_blue.tga
	}
}

// S02: inverseVertexColor (brush vertices are white: the stage adds 0), a plain stage, and
// colored (the func_static's _color through parm0-2)
textures/lp5/s02_inverse
{
	qer_editorimage	textures/lp5/s_red.tga
	{
		blend	add
		map	textures/lp5/s_red.tga
		inverseVertexColor
	}
}

textures/lp5/s02_plain
{
	qer_editorimage	textures/lp5/s_red.tga
	{
		blend	add
		map	textures/lp5/s_red.tga
	}
}

textures/lp5/s02_colored
{
	qer_editorimage	textures/lp5/white.tga
	{
		blend	add
		map	textures/lp5/white.tga
		colored
	}
}

// S03: an alpha-tested ambient stage, perforated: the prepass draws its holes, pass 8 draws
// EQUAL against them (no ALPHA_TEST of its own)
textures/lp5/s03_grate
{
	qer_editorimage	textures/lp5/s03_grate.tga
	{
		map	textures/lp5/s03_grate.tga
		alphaTest	0.5
	}
}

// S04: two materials at SS_MEDIUM, blend blend with unequal colours and alphas
textures/lp5/s04_red
{
	qer_editorimage	textures/lp5/white.tga
	{
		blend	blend
		map	textures/lp5/white.tga
		red	0.8
		green	0.2
		blue	0.2
		alpha	0.6
	}
}

textures/lp5/s04_blue
{
	qer_editorimage	textures/lp5/white.tga
	{
		blend	blend
		map	textures/lp5/white.tga
		red	0.2
		green	0.2
		blue	0.8
		alpha	0.6
	}
}

// S05: three polygonOffset decals of sort decal (the default), far and close
textures/lp5/s05_decal
{
	qer_editorimage	textures/lp5/white.tga
	polygonOffset	1
	{
		blend	blend
		map	textures/lp5/white.tga
		red	0.9
		green	0.3
		blue	0.1
		alpha	0.7
	}
}

textures/lp5/s05_far
{
	qer_editorimage	textures/lp5/white.tga
	sort	far
	polygonOffset	1
	{
		blend	blend
		map	textures/lp5/white.tga
		red	0.1
		green	0.8
		blue	0.3
		alpha	0.7
	}
}

textures/lp5/s05_close
{
	qer_editorimage	textures/lp5/white.tga
	sort	close
	polygonOffset	1
	{
		blend	blend
		map	textures/lp5/white.tga
		red	0.2
		green	0.3
		blue	0.9
		alpha	0.7
	}
}

// S06: textures/lp5/s06_implicit has no decl: the engine's implicit material (Material.cpp
// SetDefaultText: blend blend, colored, map, clamp) over its image of the same name

// S07: TG_SCREEN (the stage keyword screen, Material.cpp:1750) on texture_color_texgen
textures/lp5/s07_screen
{
	qer_editorimage	textures/lp5/s07_screen.tga
	{
		blend	add
		map	textures/lp5/s07_screen.tga
		screen
	}
}

// S12: a translucent backSided box: CT_BACK_SIDED, which the engine's GetRenderState draws
// as front-sided (GLS_CULL_BITS, D117)
textures/lp5/s12_backbox
{
	qer_editorimage	textures/lp5/white.tga
	translucent
	backSided
	{
		blend	blend
		map	textures/lp5/white.tga
		red	0.3
		green	0.7
		blue	0.9
		alpha	0.5
	}
}

// S13: a newStage program, the fork's vornoipattern (no _currentRender): iTime = USER0.x,
// iResolution = USER0.yz, constants (D119)
textures/lp5/s13_voronoi
{
	qer_editorimage	textures/lp5/white.tga
	{
		blend	add
		program	vornoipattern
		vertexParm	0	0.5, 400, 400
	}
}

// S14: the engine's fogwithlights, which samples no texture (its t_CurrentRender is declared,
// never read) and names no _currentRender here: SS_MEDIUM, drawn by pass 8; iTime =
// USER0.x, iResolution = USER0.yz, constants (D119)
textures/lp5/s14_fogwithlights
{
	qer_editorimage	textures/lp5/white.tga
	{
		blend	add
		program	fogwithlights
		vertexParm	0	0.5, 1280, 720
	}
}

// ----- LP5.2b: the texgen rooms (C48). The cubes are CF_NATIVE (cubeMap: _px _nx _py _ny
// _pz _nz, Image_files.cpp R_LoadCubeImages); every texcoord is affine per vertex (P6.5)

// S08: TG_SKYBOX_CUBE (skybox, 69) on the far wall of an unlit room: the cube's texel at
// position - the eye, colour rpColor (1)
textures/lp5/s08_sky
{
	qer_editorimage	textures/lp5/sky_px.tga
	{
		cubeMap	textures/lp5/sky
		texGen	skybox
	}
}

// S09: TG_REFLECT_CUBE without a bump stage (environment, 55: colour sRGBAToLinear( rpColor
// )) and with one (bumpyenvironment, 57: _flat raw at unit 1, colour rpColor), two opaque
// panels before the head-on lit wall (their prepass depth, pass 8 EQUAL; no interaction
// draws on them: the bump stage alone has a black diffuse), the reflection their colour
textures/lp5/s09_env
{
	qer_editorimage	textures/lp5/env_nx.tga
	{
		cubeMap	textures/lp5/env
		texGen	reflect
		rgb	0.5
	}
}

textures/lp5/s09_bumpy_env
{
	qer_editorimage	textures/lp5/env_nx.tga
	bumpmap	_flat
	{
		cubeMap	textures/lp5/env
		texGen	reflect
		rgb	0.5
	}
}

// S10: an alpha-tested TG_SKYBOX_CUBE stage: the prepass replaces texture_color by skybox
// (no clip: the whole surface's depth, black through rpColor 0), pass 8 draws the sky EQUAL;
// the gl_zero, gl_one twin is skipped by pass 8 (RenderBackend.cpp:4457): its prepass black
textures/lp5/s10_sky_tested
{
	qer_editorimage	textures/lp5/sky_px.tga
	{
		cubeMap	textures/lp5/sky
		texGen	skybox
		alphaTest	0.5
	}
}

textures/lp5/s10_sky_mask
{
	qer_editorimage	textures/lp5/sky_px.tga
	{
		blend	gl_zero, gl_one
		cubeMap	textures/lp5/sky
		texGen	skybox
		alphaTest	0.5
	}
}

// S11: an alpha-tested TG_WOBBLESKY_CUBE stage, rates 0 (D119): the prepass draws wobblesky
// with LOCALVIEWORIGIN 0 (the sky at position - 0) and the vertex colour 1 (SVC_IGNORE);
// pass 8 skips the gl_zero, gl_one stage (the prepass's sky alone) and adds the blend add
// twin's at position - the eye
textures/lp5/s11_wobble_mask
{
	qer_editorimage	textures/lp5/sky_px.tga
	{
		blend	gl_zero, gl_one
		cubeMap	textures/lp5/sky
		texGen	wobbleSky 0 0 0
		alphaTest	0.5
	}
}

textures/lp5/s11_wobble_add
{
	qer_editorimage	textures/lp5/sky_px.tga
	{
		blend	add
		cubeMap	textures/lp5/sky
		texGen	wobbleSky 0 0 0
		alphaTest	0.5
	}
}
